<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Contact Message</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: auto auto;
        padding: 0;
        box-sizing: border-box;
        font-family: "Inconsolata", monospace;
      }
      @media (max-width: 768px) {
        .main-content {
          padding: 1rem;
        }

        .detail-row {
          display: block;
        }

        .detail {
          display: block;
        }

        .detail-content {
          display: block;
          width: 100%;
        }
      }
    </style>
  </head>
  <body
    style="
      max-height: fit-content;
      max-width: 550px;
      background-color: #27272a !important;
      padding: 0 0 2rem 0;
      border-radius: 16px;
      text-align: center;
    "
  >
    <header style="border-bottom: 1px solid #9ca3af">
      <a
        style="text-decoration: none; cursor: pointer; text-align: center"
        href="https://zayed-fahim.web.app"
      >
        <img
          width="80"
          loading="lazy"
          src="https://i.ibb.co.com/9YmxdvV/logo-4.png"
          alt="logo"
          style="text-align: center; padding: 1rem 0"
        />
      </a>
    </header>

    <main style="display: block">
      <div style="max-width: 560px; width: 100%; margin: 0 auto">
        <div
          style="
            color: #fff;
            margin: 2rem 0;
            text-align: center;
            font-size: larger;
          "
        >
          <h1>New Contact Message</h1>
        </div>

        <div style="padding: 1.5rem; border-radius: 8px">
          <div
            style="
              margin-bottom: 1rem;
              border-bottom: 1px solid #9ca3af;
              padding-bottom: 0.5rem;
            "
          >
            <div
              style="
                color: #a1a1aa;
                width: 100%;
                font-weight: 600;
                text-align: left;
              "
            >
              From:
              <span
                style="
                  color: #a1a1aa !important;
                  text-decoration: none;
                  font-weight: 400;
                "
                ><%= email %></span
              >
            </div>
          </div>
          <div
            style="
              margin-bottom: 1rem;
              border-bottom: 1px solid #9ca3af;
              padding-bottom: 0.5rem;
            "
          >
            <div
              style="
                color: #a1a1aa;
                width: 100%;
                font-weight: 600;
                text-align: left;
              "
            >
              Name:
              <span style="color: #a1a1aa; font-weight: 400"
                ><%= fullName %></span
              >
            </div>
          </div>
          <div
            style="
              margin-bottom: 1rem;
              border-bottom: 1px solid #9ca3af;
              padding-bottom: 0.5rem;
              text-align: left;
            "
          >
            <div style="color: #a1a1aa; width: 100%; font-weight: 600">
              Subject:
              <span style="color: #a1a1aa; font-weight: 400"
                ><%= subject %></span
              >
            </div>
          </div>
        </div>

        <div
          style="
            color: #a1a1aa;
            line-height: 1.6;
            padding: 1.5rem;
            border-radius: 8px;
            text-align: left;
          "
        >
          <h2 style="color: #a1a1aa; margin-bottom: 1rem; font-size: 1.2rem">
            Message:
          </h2>
          <div><%= message %></div>
        </div>
      </div>
    </main>

    <footer style="padding: 0 1rem; color: #a1a1aa">
      <p>
        Copyright &copy; <%= new Date().getFullYear() %> Zayed Fahim. All rights
        reserved.
      </p>
    </footer>
  </body>
</html>
